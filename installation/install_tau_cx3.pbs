#!/bin/bash
#PBS -N tau_install
#PBS -l select=1:ncpus=32:mem=64gb:cpu_type=rome:mpiprocs=32
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o tau_install.log

set -euo pipefail

VERSION=2.35.2
SRC_ROOT="$HOME/src"
INSTALL_ROOT="$HOME/opt/tau/$VERSION"
mkdir -p "$SRC_ROOT" "$HOME/opt/tau/logs"
LOGFILE="$HOME/opt/tau/logs/tau_install_$(date +%Y%m%d_%H%M%S).log"
exec > >(tee -a "$LOGFILE") 2>&1

module purge
module load tools/prod
module load buildenv/default-foss-2025b
module load CMake/4.0.3-GCCcore-14.3.0

cd "$SRC_ROOT"
curl -fL "https://www.cs.uoregon.edu/research/tau/tau_releases/tau-$VERSION.tar.gz" -o "tau-$VERSION.tar.gz"
tar -xzf "tau-$VERSION.tar.gz"
cd "tau-$VERSION"

./configure \
    -prefix="$INSTALL_ROOT" \
    -mpi \
    -tag=cx3-foss-2025b \
    -bfd=download \
    -unwind=download \
    -perfetto
make -j32 install
